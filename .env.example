# GeeLark API Configuration
GEELARK_BASE_URL=https://openapi.geelark.com

# Preferred Auth Mode: "token" or "key"
GEELARK_AUTH_MODE=token

# Option A: Token Authentication (Recommended)
# Click "Generate token" in GeeLark GeeHub
GEELARK_BEARER_TOKEN=

# Option B: Key Authentication
GEELARK_APP_ID=your_geelark_app_id
GEELARK_API_KEY=your_geelark_api_key

# Telegram Alert Configuration
# Get bot token from @BotFather
TELEGRAM_BOT_TOKEN=
# Get chat ID from @userinfobot
TELEGRAM_CHAT_ID=

# Chime Cloud Phone Targeting (matches #226 GeeLarkPhone|$Katie-Smith-18)
CHIME_TARGET_PHONE_SERIAL=226
CHIME_TARGET_PHONE_NAME=Katie-Smith-18
CHIME_TARGET_PHONE_ID=
CHIME_APP_PIN=1122

# Monitoring interval in seconds (default: 20)
CHIME_POLL_INTERVAL=20

# Whether to take and send screenshot with Telegram alert
ENABLE_TELEGRAM_SCREENSHOTS=true
